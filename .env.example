# Admin access — Firebase Auth email(s) allowed into the dashboard (comma-separated)
ADMIN_EMAIL=admin@yourdomain.com

# Session signing secret (min 32 chars in production)
ADMIN_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public site URL (used for Open Graph / social metadata)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Firebase Web App (client-side — from Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side — from Firebase Console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# On Netlify, paste the key on one line with \n for line breaks, e.g.:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=